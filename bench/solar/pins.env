# Pinned tools and corpora for the Solar vs solc benchmark.
# Bump a pin only together with a fresh measurement on the same machine class.

# Paradigm Solar (https://github.com/paradigmxyz/solar), main as of 2026-11-20.
# Built from source at this exact commit. Version string is 0.3.0-dev.
SOLAR_REPO=https://github.com/paradigmxyz/solar
SOLAR_REV=f1b75c64ec466637d9040418268b365211d0e939

# Official solc static Linux binary (argotorg/solidity).
SOLC_VERSION=0.8.39
SOLC_URL=https://github.com/argotorg/solidity/releases/download/v0.8.39/solc-static-linux

# OpenZeppelin Contracts v5.7.0
OZ_REPO=https://github.com/OpenZeppelin/openzeppelin-contracts
OZ_REV=v5.7.0
OZ_COMMIT=cab19933c33c2ad1d4c7a84864a3601dddfd16f3

# Uniswap v3 core v1.0.0 (Solidity =0.7.6). The pinned solc 0.8.39 rejects the pragma,
# so only Solar is measured, and only through lowering.
UNISWAP_V3_REPO=https://github.com/Uniswap/v3-core
UNISWAP_V3_REV=v1.0.0
UNISWAP_V3_COMMIT=e3589b192d0be27e100cd0daaf6c97204fdb1899

# Uniswap v4 core v4.0.0 (Solidity 0.8.26 / ^0.8.x).
UNISWAP_V4_REPO=https://github.com/Uniswap/v4-core
UNISWAP_V4_REV=v4.0.0
UNISWAP_V4_COMMIT=e50237c43811bd9b526eff40f26772152a42daba

# solmate commit recorded as the lib/solmate submodule of Uniswap v4-core v4.0.0.
# Fetched only to satisfy the production import in src/ProtocolFees.sol. Not a corpus of its own.
SOLMATE_REPO=https://github.com/transmissions11/solmate
SOLMATE_COMMIT=4b47a19038b798b4a33d9749d25e570443520647
